# Database Configuration (Defaults to local SQLite for instant zero-dependency run)
DATABASE_URL=sqlite:///./resume_analyzer.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/resume_analyzer_db

# AI / LLM Configuration (Optional - full fallback NLP engine works automatically without keys!)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=auto

# Security & Upload Configuration
MAX_UPLOAD_SIZE_MB=15
